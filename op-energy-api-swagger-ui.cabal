cabal-version:      2.4
name:               op-energy-api-swagger-ui
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- A URL where users can report bugs.
-- bug-reports:

-- The license under which the package is released.
-- license:

-- A copyright notice.
-- copyright:
-- category:
-- extra-source-files:
executable op-energy-api-swagger-ui
    main-is:          Main.hs

    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:
    build-depends:    base >=4.16.1.0
                    , op-energy-api-swagger-ui
    hs-source-dirs:   app
    default-language: Haskell2010
    default-extensions:       OverloadedStrings
    ghc-options:    -O2 -threaded -rtsopts "-with-rtsopts=-T -N"

library
    hs-source-dirs: src
    exposed-modules: API
                   , Config

    build-depends:    base >=4.16.1.0
                    , text
                    , bytestring
                    , lens
                    , containers
                    , aeson
                    , aeson-pretty
                    , async
                    , servant
                    , servant-server, servant-client, servant-jsonrpc, servant-jsonrpc-client
                    , servant-swagger, servant-swagger-ui, servant-websockets
                    , swagger2
                    , lens
                    , scientific
                    , random
                    , warp
                    , wai
                    , op-energy-api
                    , op-energy-account-api
                    , op-energy-offer-api
    ghc-options:    -O2 -Wall -Werror -Wno-unticked-promoted-constructors -fno-warn-name-shadowing -Wno-orphans
    default-extensions:       OverloadedStrings
                            , ScopedTypeVariables
                            , BangPatterns

